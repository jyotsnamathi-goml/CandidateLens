# --- LLM ---
OPENAI_API_KEY=sk-placeholder-add-your-key-here
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE_EXTRACT=0.0
LLM_TEMPERATURE_EVAL=0.1
LLM_TEMPERATURE_QUESTIONS=0.5
LLM_MOCK=true
ENABLE_LLM_FOLLOWUPS=false
ENABLE_VECTOR_RETRIEVAL=false

# --- Token budgets (hard caps on INPUT chars sent per call, trimmed before sending) ---
MAX_INPUT_CHARS_EXTRACTION=24000
MAX_INPUT_CHARS_QUESTIONS=9000
MAX_INPUT_CHARS_EVALUATION=16000
MAX_OUTPUT_TOKENS_EXTRACTION=4000
MAX_OUTPUT_TOKENS_QUESTIONS=1800
MAX_OUTPUT_TOKENS_EVALUATION=3000
PER_CANDIDATE_COST_CAP_USD=0.50

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_MAX_REPOS=3
GITHUB_MAX_COMMITS_SCANNED=100

# --- Assessment ---
MAX_TURNS=8
MAX_FOLLOWUPS_PER_QUESTION=1
ASSESSMENT_MAX_MINUTES=30
PER_QUESTION_MINUTES=6
ASSESSMENT_LINK_TTL_HOURS=72
VAGUE_ANSWER_MIN_WORDS=40

# --- Proctoring ---
ENABLE_PROCTORING=true
PROCTORING_DISABLE_COPY_PASTE=true
PROCTORING_TRACK_TAB_SWITCH=true

# --- Scoring ---
SPARSE_FACTOR=0.5
BAND_STRONG_MIN=80
BAND_MODERATE_MIN=60

# --- Auth ---
HR_USERNAME=hr
HR_PASSWORD=adminpassword123
JWT_SECRET=supersecret-candidatelens-jwt-key-2026
LINK_SIGNING_SECRET=supersecret-candidatelens-link-key-2026
JWT_TTL_MINUTES=480

# --- Data ---
DATA_DIR=./data
RETENTION_DAYS=90
FRONTEND_ORIGIN=http://localhost:5173
